<?xml version="1.0" encoding="utf-8"?>
<!-- Main screen: a status card, then the steps of a setup (aim, field metadata, schedule, phone
     check, start), so a phone is ready in a few taps. The detailed settings open only on "Change";
     saved values stay on the phone. Explanations open with the (i) of their label (HelpToggles).
     fitsSystemWindows keeps the content clear of the status and navigation bars.
     importantForAutofill="no": these are settings, not personal data (Android 8+). TooManyViews:
     the screen is built once, and each setting needs its views. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/scroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    tools:ignore="TooManyViews">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp">

        <!-- Status: the phone name, what runs now (nothing while idle), warnings, where the files
             go; the last session, battery and clock fold away under their own line. -->
        <LinearLayout style="@style/Card" android:layout_marginTop="0dp">
            <TextView android:id="@+id/status_title" style="@style/CardTitle" android:textSize="20sp" />
            <TextView android:id="@+id/session_state" style="@style/Body" android:textStyle="bold" />
            <TextView android:id="@+id/session_status" style="@style/Body" />
            <TextView android:id="@+id/session_progress" style="@style/Body" />
            <TextView android:id="@+id/session_warning" style="@style/Body" android:textColor="@color/warning" android:textStyle="bold" />
            <LinearLayout android:id="@+id/session_checks" style="@style/Group" />
            <TextView android:id="@+id/storage" style="@style/Body" android:layout_marginTop="8dp"
                android:textSize="15sp" />
            <TextView android:id="@+id/details_toggle" style="@style/Body" android:minHeight="48dp"
                android:gravity="center_vertical" android:textColor="@color/heading" />
            <LinearLayout android:id="@+id/details" style="@style/Group" android:visibility="gone">
                <TextView android:id="@+id/last_session" style="@style/Body" android:layout_marginTop="0dp"
                    android:textSize="15sp" />
                <TextView android:id="@+id/battery" style="@style/Hint" android:layout_marginTop="8dp" />
                <TextView android:id="@+id/phone_time" style="@style/Hint" />
                <TextView android:id="@+id/phone_id" style="@style/Hint" />
            </LinearLayout>
            <Button android:id="@+id/stop_session" style="@style/BigButton"
                android:backgroundTint="@color/stop" android:text="@string/stop_session" />
        </LinearLayout>

        <!-- 1: what to record, and where the camera looks -->
        <LinearLayout android:id="@+id/aim_card" style="@style/Card">
            <TextView style="@style/CardTitle" android:text="@string/card_aim" />
            <RadioGroup android:id="@+id/mode" style="@style/Segments">
                <RadioButton android:id="@+id/mode_photo" style="@style/Segment" android:text="@string/mode_photo" />
                <RadioButton android:id="@+id/mode_video" style="@style/Segment.Next" android:text="@string/mode_video" />
            </RadioGroup>
            <Button android:id="@+id/aim" style="@style/SecondaryButton" android:layout_marginTop="12dp"
                android:text="@string/aim_button" />
            <TextView android:id="@+id/aim_summary" style="@style/Hint" android:layout_marginTop="4dp" />
        </LinearLayout>

        <!-- 2: where and what (FieldInfo); it changes at each site or plant, so the fields stay open.
             LabelFor: each field has its label, and the grey hint inside gives an example. -->
        <LinearLayout android:id="@+id/field_card" style="@style/Card" tools:ignore="LabelFor">
            <TextView style="@style/CardTitle.Help" android:text="@string/card_field" />
            <TextView style="@style/Hint.Help" android:text="@string/field_help" />
            <LinearLayout style="@style/FieldRow">
                <TextView style="@style/FieldLabel" android:labelFor="@id/site" android:text="@string/field_site" />
                <EditText android:id="@+id/site" style="@style/Field.Row" android:hint="@string/field_site_hint"
                    android:importantForAutofill="no" android:inputType="textCapSentences" tools:targetApi="o" />
            </LinearLayout>
            <LinearLayout style="@style/FieldRow">
                <TextView style="@style/FieldLabel" android:labelFor="@id/transect" android:text="@string/field_transect" />
                <EditText android:id="@+id/transect" style="@style/Field.Row" android:hint="@string/field_transect_hint"
                    android:importantForAutofill="no" android:inputType="text" tools:targetApi="o" />
            </LinearLayout>
            <LinearLayout style="@style/FieldRow">
                <TextView style="@style/FieldLabel" android:labelFor="@id/plant" android:text="@string/field_plant" />
                <EditText android:id="@+id/plant" style="@style/Field.Row" android:hint="@string/field_plant_hint"
                    android:importantForAutofill="no" android:inputType="textCapSentences" tools:targetApi="o" />
            </LinearLayout>
            <LinearLayout style="@style/FieldRow">
                <TextView style="@style/FieldLabel" android:labelFor="@id/sample_id" android:text="@string/field_sample" />
                <EditText android:id="@+id/sample_id" style="@style/Field.Row" android:hint="@string/field_optional"
                    android:importantForAutofill="no" android:inputType="text" tools:targetApi="o" />
            </LinearLayout>
            <LinearLayout style="@style/FieldRow">
                <TextView style="@style/FieldLabel" android:labelFor="@id/session_id" android:text="@string/field_session" />
                <EditText android:id="@+id/session_id" style="@style/Field.Row" android:hint="@string/field_optional"
                    android:importantForAutofill="no" android:inputType="text" tools:targetApi="o" />
            </LinearLayout>
            <LinearLayout style="@style/FieldRow">
                <TextView style="@style/FieldLabel" android:labelFor="@id/device_name" android:text="@string/field_phone" />
                <EditText android:id="@+id/device_name" style="@style/Field.Row" android:maxLength="20"
                    android:importantForAutofill="no" android:inputType="text" tools:targetApi="o" />
            </LinearLayout>
            <LinearLayout style="@style/FieldRow">
                <TextView style="@style/FieldLabel" android:labelFor="@id/latitude" android:text="@string/field_latitude" />
                <EditText android:id="@+id/latitude" style="@style/Field.Row" android:hint="@string/field_latitude_hint"
                    android:importantForAutofill="no" android:inputType="numberSigned|numberDecimal" tools:targetApi="o" />
            </LinearLayout>
            <LinearLayout style="@style/FieldRow">
                <TextView style="@style/FieldLabel" android:labelFor="@id/longitude" android:text="@string/field_longitude" />
                <EditText android:id="@+id/longitude" style="@style/Field.Row" android:hint="@string/field_longitude_hint"
                    android:importantForAutofill="no" android:inputType="numberSigned|numberDecimal" tools:targetApi="o" />
            </LinearLayout>
            <TextView android:id="@+id/location_text" style="@style/Body" android:layout_marginTop="8dp"
                android:textSize="15sp" />
            <Button android:id="@+id/get_location" style="@style/SecondaryButton" android:text="@string/location_get" />
        </LinearLayout>

        <!-- 3: when and how often; the details open on "Change" -->
        <LinearLayout android:id="@+id/schedule_card" style="@style/Card">
            <TextView style="@style/CardTitle" android:text="@string/card_schedule" />
            <TextView android:id="@+id/schedule_summary" style="@style/Body" />
            <Button android:id="@+id/change" style="@style/SecondaryButton" android:text="@string/change_open" />

            <LinearLayout android:id="@+id/settings" style="@style/Group" android:visibility="gone">
                <LinearLayout android:id="@+id/photo_settings" style="@style/Group">
                    <TextView style="@style/Label.Help" android:labelFor="@id/step_s" android:text="@string/step_label" />
                    <EditText android:id="@+id/step_s" style="@style/Field" android:importantForAutofill="no"
                        android:inputType="numberDecimal" tools:targetApi="o" />
                    <TextView style="@style/Hint.Help" android:text="@string/step_hint" />

                    <TextView style="@style/Label.Help" android:labelFor="@id/burst_s" android:text="@string/burst_label" />
                    <EditText android:id="@+id/burst_s" style="@style/Field" android:importantForAutofill="no"
                        android:inputType="numberDecimal" tools:targetApi="o" />
                    <TextView style="@style/Hint.Help" android:text="@string/burst_hint" />
                </LinearLayout>

                <LinearLayout android:id="@+id/video_settings" style="@style/Group">
                    <TextView style="@style/Label.Help" android:labelFor="@id/clip_min" android:text="@string/clip_label" />
                    <EditText android:id="@+id/clip_min" style="@style/Field" android:importantForAutofill="no"
                        android:inputType="numberDecimal" tools:targetApi="o" />
                    <TextView style="@style/Hint.Help" android:text="@string/clip_hint" />

                    <TextView style="@style/Label.Help" android:text="@string/video_fps_label" />
                    <RadioGroup android:id="@+id/video_fps" style="@style/Segments">
                        <RadioButton android:id="@+id/video_fps_5" style="@style/Segment" android:text="@string/video_fps_5" />
                        <RadioButton android:id="@+id/video_fps_10" style="@style/Segment.Next" android:text="@string/video_fps_10" />
                        <RadioButton android:id="@+id/video_fps_15" style="@style/Segment.Next" android:text="@string/video_fps_15" />
                    </RadioGroup>
                    <TextView style="@style/Hint.Help" android:text="@string/video_fps_hint" />
                </LinearLayout>

                <TextView style="@style/Label.Help" android:labelFor="@id/break_min" android:text="@string/break_label" />
                <EditText android:id="@+id/break_min" style="@style/Field" android:importantForAutofill="no"
                    android:inputType="numberDecimal" tools:targetApi="o" />
                <TextView style="@style/Hint.Help" android:text="@string/break_hint" />

                <TextView style="@style/Label" android:text="@string/schedule_label" />
                <RadioGroup android:id="@+id/schedule" style="@style/Segments">
                    <RadioButton android:id="@+id/schedule_run" style="@style/Segment" android:text="@string/schedule_run" />
                    <RadioButton android:id="@+id/schedule_daily" style="@style/Segment.Next" android:text="@string/schedule_daily" />
                </RadioGroup>

                <LinearLayout android:id="@+id/run_settings" style="@style/Group">
                    <TextView style="@style/Label.Help" android:text="@string/run_label" />
                    <LinearLayout style="@style/FieldRow" android:layout_marginTop="0dp">
                        <EditText android:id="@+id/run_h" style="@style/Field.Row" android:importantForAutofill="no"
                            android:inputType="number" android:contentDescription="@string/run_hours" tools:targetApi="o" />
                        <TextView style="@style/Body" android:layout_width="wrap_content" android:layout_marginTop="0dp"
                            android:layout_marginStart="8dp" android:layout_marginEnd="16dp" android:text="@string/unit_h" />
                        <EditText android:id="@+id/run_m" style="@style/Field.Row" android:importantForAutofill="no"
                            android:inputType="number" android:contentDescription="@string/run_minutes" tools:targetApi="o" />
                        <TextView style="@style/Body" android:layout_width="wrap_content" android:layout_marginTop="0dp"
                            android:layout_marginStart="8dp" android:text="@string/unit_min" />
                    </LinearLayout>
                    <TextView style="@style/Hint.Help" android:text="@string/run_hint" />
                </LinearLayout>

                <LinearLayout android:id="@+id/daily_settings" style="@style/Group">
                    <TextView style="@style/Label.Help" android:labelFor="@id/windows" android:text="@string/windows_label" />
                    <EditText android:id="@+id/windows" style="@style/Field" android:importantForAutofill="no"
                        android:inputType="text" tools:targetApi="o" />
                    <TextView style="@style/Hint.Help" android:text="@string/windows_hint" />

                    <TextView style="@style/Label.Help" android:labelFor="@id/days" android:text="@string/days_label" />
                    <EditText android:id="@+id/days" style="@style/Field" android:importantForAutofill="no"
                        android:inputType="number" tools:targetApi="o" />
                    <TextView style="@style/Hint.Help" android:text="@string/days_hint" />
                </LinearLayout>

                <TextView style="@style/Label.Help" android:labelFor="@id/saved_side" android:text="@string/saved_side_label" />
                <EditText android:id="@+id/saved_side" style="@style/Field" android:importantForAutofill="no"
                    android:inputType="number" tools:targetApi="o" />
                <TextView style="@style/Hint.Help" android:text="@string/saved_side_hint" />

                <TextView style="@style/Label.Help" android:labelFor="@id/heat_limit_c" android:text="@string/heat_label" />
                <EditText android:id="@+id/heat_limit_c" style="@style/Field" android:importantForAutofill="no"
                    android:inputType="numberDecimal" tools:targetApi="o" />
                <TextView style="@style/Hint.Help" android:text="@string/heat_hint" />

                <Button android:id="@+id/defaults" style="@style/SecondaryButton" android:layout_marginTop="16dp"
                    android:text="@string/defaults" />
            </LinearLayout>
        </LinearLayout>

        <!-- 4: the phone for the field (PhoneCheck); only what should change is listed (during a
             session in the status card instead) -->
        <LinearLayout android:id="@+id/phone_card" style="@style/Card">
            <TextView style="@style/CardTitle" android:text="@string/card_phone" />
            <LinearLayout android:id="@+id/phone_checks" style="@style/Group" />
            <TextView style="@style/Label.Help" android:text="@string/checklist_label" />
            <TextView style="@style/Hint.Help" android:text="@string/checklist_text" />
        </LinearLayout>

        <!-- Start -->
        <TextView android:id="@+id/start_message" style="@style/Body" android:layout_marginTop="12dp"
            android:textColor="@color/warning" android:textStyle="bold" android:visibility="gone" />
        <Button android:id="@+id/start_session" style="@style/BigButton" android:text="@string/start_session" />
        <TextView android:id="@+id/start_hint" style="@style/Hint" android:layout_marginTop="4dp"
            android:text="@string/start_hint" />

        <!-- Phone tests (phase 0): folded away -->
        <Button android:id="@+id/tests_toggle" style="?android:attr/borderlessButtonStyle"
            android:textAllCaps="false" android:textColor="@color/heading"
            android:layout_width="wrap_content" android:layout_height="48dp"
            android:layout_marginTop="24dp" android:text="@string/tests_show" />

        <LinearLayout android:id="@+id/tests" style="@style/Card" android:layout_marginTop="0dp"
            android:visibility="gone">
            <TextView android:id="@+id/intro" style="@style/Body" />
            <Button android:id="@+id/take_photo" style="@style/SecondaryButton" android:text="@string/take_photo" />
            <Button android:id="@+id/speed_test" style="@style/SecondaryButton" android:text="@string/speed_test" />
            <TextView
                android:id="@+id/status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:textIsSelectable="true"
                android:textSize="14sp"
                android:typeface="monospace" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
