<?xml version="1.0" encoding="utf-8"?>
<!-- Main screen: a status card, then the steps of a setup (aim, field metadata, schedule, phone
     check, start), so a phone is ready in a few taps; then Support. Field metadata and schedule
     show a summary; "Change" opens their own screen; saved values stay on the phone. Explanations
     open with the (i) of their label (HelpToggles). fitsSystemWindows keeps the content clear of
     the status and navigation bars. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/scroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp">

        <!-- Status: what runs now, warnings, where the files go; the last session, battery and
             clock fold away under their own line. -->
        <LinearLayout style="@style/Card" android:layout_marginTop="0dp">
            <TextView style="@style/CardTitle" android:textSize="20sp" android:text="@string/status_title" />
            <TextView android:id="@+id/session_state" style="@style/Body" android:textStyle="bold" />
            <TextView android:id="@+id/session_status" style="@style/Body" />
            <TextView android:id="@+id/session_progress" style="@style/Body" />
            <TextView android:id="@+id/session_warning" style="@style/Body" android:textColor="@color/warning" android:textStyle="bold" />
            <LinearLayout android:id="@+id/session_checks" style="@style/Group" />
            <!-- During a session: the newest saved square (or a frame of the last clip); a tap enlarges it -->
            <ImageView android:id="@+id/last_photo" android:layout_width="160dp" android:layout_height="160dp"
                android:layout_marginTop="8dp" android:scaleType="fitCenter" android:visibility="gone"
                tools:ignore="ContentDescription" />
            <TextView android:id="@+id/last_photo_text" style="@style/Hint" android:visibility="gone" />
            <TextView android:id="@+id/storage" style="@style/Body" android:layout_marginTop="8dp"
                android:textSize="15sp" />
            <!-- With a memory card: where new sessions go (Storage), and all places together -->
            <RadioGroup android:id="@+id/storage_places" style="@style/Group" android:visibility="gone" />
            <TextView android:id="@+id/storage_total" style="@style/Body" android:textSize="15sp" />
            <TextView android:id="@+id/storage_note" style="@style/Hint" android:layout_marginTop="4dp"
                android:text="@string/storage_card_speed" android:visibility="gone" />
            <!-- Screen off only during a session; then Open the folder shares the line -->
            <LinearLayout style="@style/FieldRow" android:layout_marginTop="0dp">
                <Button android:id="@+id/screen_off" style="@style/SecondaryButton" android:layout_width="0dp"
                    android:layout_weight="1" android:layout_marginEnd="8dp" android:text="@string/screen_off" />
                <Button android:id="@+id/open_folder" style="@style/SecondaryButton" android:layout_width="0dp"
                    android:layout_weight="1" android:text="@string/open_folder" />
            </LinearLayout>
            <!-- When nothing runs: photo sessions not packed yet, packing and its outcome (SessionZip) -->
            <LinearLayout android:id="@+id/pack_group" style="@style/Group" android:visibility="gone">
                <TextView style="@style/Label.Help" android:text="@string/pack_label" />
                <TextView style="@style/Hint.Help" android:text="@string/pack_help" />
                <TextView android:id="@+id/pack_status" style="@style/Body" android:textSize="15sp" />
                <Button android:id="@+id/pack" style="@style/SecondaryButton" android:text="@string/pack_button" />
            </LinearLayout>
            <!-- Pause during a session; while paused: the aim screen, and Continue -->
            <Button android:id="@+id/pause_session" style="@style/SecondaryButton" android:text="@string/pause_session" />
            <Button android:id="@+id/adjust_camera" style="@style/SecondaryButton" android:text="@string/adjust_camera" />
            <Button android:id="@+id/continue_session" style="@style/BigButton" android:text="@string/continue_session" />
            <TextView android:id="@+id/details_toggle" style="@style/Body" android:minHeight="48dp"
                android:gravity="center_vertical" android:textColor="@color/heading" />
            <LinearLayout android:id="@+id/details" style="@style/Group" android:visibility="gone">
                <TextView android:id="@+id/last_session" style="@style/Body" android:layout_marginTop="0dp"
                    android:textSize="15sp" />
                <TextView android:id="@+id/battery" style="@style/Hint" android:layout_marginTop="8dp" />
                <TextView android:id="@+id/phone_time" style="@style/Hint" />
                <!-- While FaunaLapse may lock the screen (ScreenOff): how to give that right back -->
                <LinearLayout android:id="@+id/screen_off_right" style="@style/FieldRow" android:layout_marginTop="8dp"
                    android:visibility="gone">
                    <TextView style="@style/Hint" android:layout_width="0dp" android:layout_weight="1"
                        android:text="@string/screen_off_allowed" />
                    <Button android:id="@+id/screen_off_remove" style="@style/SecondaryButton"
                        android:layout_width="wrap_content" android:layout_height="48dp" android:layout_marginTop="0dp"
                        android:layout_marginStart="12dp" android:textSize="15sp" android:text="@string/screen_off_remove" />
                </LinearLayout>
            </LinearLayout>
            <Button android:id="@+id/stop_session" style="@style/BigButton"
                android:backgroundTint="@color/stop" android:text="@string/stop_session" />
        </LinearLayout>

        <!-- 1: what to record, and where the camera looks -->
        <LinearLayout android:id="@+id/aim_card" style="@style/Card">
            <TextView style="@style/CardTitle" android:text="@string/card_aim" />
            <RadioGroup android:id="@+id/mode" style="@style/Segments">
                <RadioButton android:id="@+id/mode_photo" style="@style/Segment" android:text="@string/mode_photo" />
                <RadioButton android:id="@+id/mode_video" style="@style/Segment.Next" android:text="@string/mode_video" />
            </RadioGroup>
            <Button android:id="@+id/aim" style="@style/SecondaryButton" android:layout_marginTop="12dp"
                android:text="@string/aim_button" />
            <TextView android:id="@+id/aim_summary" style="@style/Hint" android:layout_marginTop="4dp" />
        </LinearLayout>

        <!-- 2: who, where and what (FieldInfo): a summary; Change opens the field metadata screen -->
        <LinearLayout android:id="@+id/field_card" style="@style/Card">
            <TextView style="@style/CardTitle" android:text="@string/card_field" />
            <TextView android:id="@+id/field_summary" style="@style/Body" />
            <Button android:id="@+id/field_change" style="@style/SecondaryButton" android:text="@string/field_open" />
        </LinearLayout>

        <!-- 3: when and how often: a summary; Change opens the schedule screen -->
        <LinearLayout android:id="@+id/schedule_card" style="@style/Card">
            <TextView style="@style/CardTitle" android:text="@string/card_schedule" />
            <TextView android:id="@+id/schedule_summary" style="@style/Body" />
            <Button android:id="@+id/change" style="@style/SecondaryButton" android:text="@string/change_open" />
        </LinearLayout>

        <!-- 4: the phone for the field (PhoneCheck); only what should change is listed (during a
             session in the status card instead) -->
        <LinearLayout android:id="@+id/phone_card" style="@style/Card">
            <TextView style="@style/CardTitle" android:text="@string/card_phone" />
            <LinearLayout android:id="@+id/phone_checks" style="@style/Group" />
            <TextView style="@style/Label.Help" android:text="@string/checklist_label" />
            <TextView style="@style/Hint.Help" android:text="@string/checklist_text" />
        </LinearLayout>

        <!-- Start -->
        <TextView android:id="@+id/start_message" style="@style/Body" android:layout_marginTop="12dp"
            android:textColor="@color/warning" android:textStyle="bold" android:visibility="gone" />
        <Button android:id="@+id/start_session" style="@style/BigButton" android:text="@string/start_session" />
        <TextView android:id="@+id/start_hint" style="@style/Hint" android:layout_marginTop="4dp"
            android:text="@string/start_hint" />

        <!-- Support FaunaLapse (Support): share, cite, report a problem. They open other apps (the
             share window, the browser): FaunaLapse itself has no network access. -->
        <LinearLayout style="@style/Card" android:layout_marginTop="24dp">
            <TextView style="@style/CardTitle" android:text="@string/support_title" />
            <TextView style="@style/Body" android:text="@string/support_text" />
            <LinearLayout style="@style/FieldRow" android:layout_marginTop="0dp">
                <Button android:id="@+id/share" style="@style/SecondaryButton" android:layout_width="0dp"
                    android:layout_weight="1" android:layout_marginEnd="8dp" android:text="@string/support_share" />
                <Button android:id="@+id/cite" style="@style/SecondaryButton" android:layout_width="0dp"
                    android:layout_weight="1" android:text="@string/support_cite" />
            </LinearLayout>
            <Button android:id="@+id/report" style="@style/SecondaryButton" android:text="@string/support_report" />
        </LinearLayout>

        <!-- Phone tests (phase 0): folded away, debug builds only (MainActivity) -->
        <Button android:id="@+id/tests_toggle" style="?android:attr/borderlessButtonStyle"
            android:textAllCaps="false" android:textColor="@color/heading"
            android:layout_width="wrap_content" android:layout_height="48dp"
            android:layout_marginTop="24dp" android:text="@string/tests_show" />

        <LinearLayout android:id="@+id/tests" style="@style/Card" android:layout_marginTop="0dp"
            android:visibility="gone">
            <TextView android:id="@+id/intro" style="@style/Body" />
            <Button android:id="@+id/take_photo" style="@style/SecondaryButton" android:text="@string/take_photo" />
            <Button android:id="@+id/speed_test" style="@style/SecondaryButton" android:text="@string/speed_test" />
            <TextView
                android:id="@+id/status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:textIsSelectable="true"
                android:textSize="14sp"
                android:typeface="monospace" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
