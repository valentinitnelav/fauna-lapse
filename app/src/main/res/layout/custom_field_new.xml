<?xml version="1.0" encoding="utf-8"?>
<!-- "Add a field" (CustomFields): its name and its type; the tags are the types in FieldInfo.Custom.
     LabelFor: the name has its label, and the grey hint inside gives an example. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="24dp"
    android:paddingEnd="24dp"
    android:paddingTop="8dp"
    tools:ignore="LabelFor">

    <TextView style="@style/Body" android:labelFor="@id/custom_new_name" android:text="@string/custom_name_label" />
    <EditText android:id="@+id/custom_new_name" style="@style/Field" android:hint="@string/custom_name_hint"
        android:inputType="textCapSentences" android:importantForAutofill="no" tools:targetApi="o" />

    <TextView style="@style/Body" android:layout_marginTop="16dp" android:text="@string/custom_type_label" />
    <RadioGroup android:id="@+id/custom_new_type" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:checkedButton="@id/custom_type_text">
        <RadioButton android:id="@+id/custom_type_text" android:layout_width="match_parent"
            android:layout_height="48dp" android:tag="text" android:text="@string/custom_type_text" />
        <RadioButton android:id="@+id/custom_type_number" android:layout_width="match_parent"
            android:layout_height="48dp" android:tag="number" android:text="@string/custom_type_number" />
        <RadioButton android:id="@+id/custom_type_date" android:layout_width="match_parent"
            android:layout_height="48dp" android:tag="date" android:text="@string/custom_type_date" />
        <RadioButton android:id="@+id/custom_type_time" android:layout_width="match_parent"
            android:layout_height="48dp" android:tag="time" android:text="@string/custom_type_time" />
    </RadioGroup>
</LinearLayout>
