<?xml version="1.0" encoding="utf-8"?>
<!-- Aim screen. keepScreenOn: the screen does not switch off while aiming. The camera view's size
     is set in AimActivity.fitView, to the shape of the camera frames. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:keepScreenOn="true"
    android:orientation="vertical">

    <FrameLayout
        android:id="@+id/camera_frame"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal">

        <TextureView
            android:id="@+id/camera_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <com.faunalapse.app.SquareView
            android:id="@+id/square"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />
    </FrameLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingBottom="16dp">

            <!-- Buttons with a filled background: easier to see outdoors than borderless ones. -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:orientation="horizontal"
                tools:ignore="ButtonStyle">

                <Button android:id="@+id/focus" style="@style/SecondaryButton" android:layout_width="0dp"
                    android:layout_weight="1" android:textSize="15sp" android:text="@string/aim_focus" />

                <Button android:id="@+id/middle" style="@style/SecondaryButton" android:layout_width="0dp"
                    android:layout_weight="1" android:layout_marginStart="8dp" android:textSize="15sp"
                    android:text="@string/aim_middle" />

                <Button android:id="@+id/done" style="@style/SecondaryButton" android:layout_width="0dp"
                    android:layout_weight="1" android:layout_marginStart="8dp" android:textSize="15sp"
                    android:text="@string/aim_done" />
            </LinearLayout>

            <TextView android:id="@+id/focus_result" style="@style/Hint" android:layout_marginTop="4dp" />

            <Button android:id="@+id/start_here" style="@style/BigButton" android:text="@string/aim_start" />

            <LinearLayout android:id="@+id/size_group" style="@style/Group">
                <TextView style="@style/Label" android:labelFor="@id/square_size" android:text="@string/square_label" />
                <SeekBar
                    android:id="@+id/square_size"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:max="90" />
            </LinearLayout>

            <!-- Focus: auto at each burst or clip, or fixed at one distance (Camera2 phones only). -->
            <LinearLayout android:id="@+id/focus_group" style="@style/Group" android:visibility="gone">
                <TextView style="@style/Label" android:text="@string/focus_label" />
                <RadioGroup android:id="@+id/focus_mode" style="@style/Segments">
                    <RadioButton android:id="@+id/focus_auto" style="@style/Segment" android:text="@string/focus_auto" />
                    <RadioButton android:id="@+id/focus_fixed" style="@style/Segment.Next" android:text="@string/focus_fixed" />
                </RadioGroup>
                <LinearLayout android:id="@+id/fixed_group" style="@style/Group">
                    <TextView android:id="@+id/focus_distance" style="@style/Body" android:layout_marginTop="8dp" />
                    <SeekBar
                        android:id="@+id/focus_slider"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:max="1000" />
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">
                        <TextView style="@style/Hint" android:layout_width="0dp" android:layout_weight="1"
                            android:text="@string/focus_near" />
                        <TextView style="@style/Hint" android:layout_width="0dp" android:layout_weight="1"
                            android:gravity="end" android:text="@string/focus_far" />
                    </LinearLayout>
                </LinearLayout>
                <TextView android:id="@+id/focus_hint" style="@style/Hint" android:layout_marginTop="4dp" />
            </LinearLayout>

            <TextView
                android:id="@+id/aim_info"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:textSize="16sp" />

            <TextView android:id="@+id/aim_hint" style="@style/Hint" android:layout_marginTop="8dp" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
