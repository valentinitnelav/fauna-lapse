<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-feature android:name="android.hardware.camera" android:required="true" />

    <uses-permission android:name="android.permission.CAMERA" />
    <!-- Keeps the processor awake while the screen is off. -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- Foreground service: background work that Android keeps alive because it shows a
         permanent notification. Android 9+ needs the first line, Android 14+ also the second. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CAMERA" />
    <!-- Android 13+: needed to show that notification. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Lets the phone check ask once to run FaunaLapse without battery limits, so long sessions
         are not stopped (the user answers in Android's own dialog). -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <!-- Get location: one GPS position for the session record, only while the screen shows it.
         Android 12+ asks for both and lets the user choose; the GPS needs the precise one. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-feature android:name="android.hardware.location.gps" android:required="false" />
    <!-- Android 10 and older: needed to save sessions in Documents/FaunaLapse (newer Android allows
         it without a permission). -->
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="29" />

    <!-- requestLegacyExternalStorage: Android 10 then allows plain file paths in the shared storage,
         as older and newer Android do. -->
    <application
        android:allowBackup="false"
        android:requestLegacyExternalStorage="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Portrait only: the camera view then turns with the phone like a window, and the
             square maths needs only the sensor orientation. Phones keep this lock; only large
             screens (tablets) ignore it from Android 16. -->
        <activity
            android:name=".AimActivity"
            android:exported="false"
            android:label="@string/aim_button"
            android:screenOrientation="portrait"
            tools:ignore="DiscouragedApi,LockedOrientationActivity" />

        <service
            android:name=".CaptureService"
            android:exported="false"
            android:foregroundServiceType="camera" />

        <!-- Site photos (SitePhotos): the phone's camera app writes each photo through this link.
             Not exported: a camera app may use only the one link FaunaLapse gives it. -->
        <provider
            android:name=".SitePhotos$Provider"
            android:authorities="${applicationId}.sitephotos"
            android:exported="false"
            android:grantUriPermissions="true" />

        <!-- "Screen off" (ScreenOff): a device admin app with the single right to lock the screen;
             only Android itself can bind to it (BIND_DEVICE_ADMIN). -->
        <receiver
            android:name=".ScreenOff"
            android:exported="true"
            android:permission="android.permission.BIND_DEVICE_ADMIN">
            <meta-data android:name="android.app.device_admin" android:resource="@xml/screen_off" />
            <intent-filter>
                <action android:name="android.app.action.DEVICE_ADMIN_ENABLED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
